# Postgres. Local or Neon — postgres.js talks to both, so development and
# production cannot drift apart on connection behaviour.
DATABASE_URL=postgres://saviora:password@localhost:5432/saviora

# Signs the doctor's session cookie. Any long random string: openssl rand -hex 32
SESSION_SECRET=

# Answering patient questions and reading lab reports.
ANTHROPIC_API_KEY=

# Where the patient's link points. No trailing slash.
PUBLIC_BASE_URL=http://localhost:3000

# Our own copy of uploaded documents and report photos. Optional: without it
# the assistant still answers and still reads reports, but the doctor cannot
# re-open the original file from the library.
BLOB_READ_WRITE_TOKEN=

# WhatsApp Cloud API. Without these the bot runs on /api/dev/simulate only.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# The clinic's WhatsApp number in E.164 digits, e.g. 919820000000. This is the
# number the patient's page invites them to write to — their message opens
# Meta's 24-hour window, which is what keeps approved templates off the
# critical path for the pilot.
WHATSAPP_PUBLIC_NUMBER=

# Lets /api/dev/simulate run in production. Leave blank to keep it to dev.
SIMULATE_KEY=
