# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …but the template carries no secrets and a fresh clone needs it.
!.env.example
# `vercel env pull` writes whatever filename it is given, and `.env*` only
# catches names that START with .env — a pull to `prod.env` lands a file full
# of production secrets in the repo root that git will happily track. It has
# happened twice.
*.env
prod.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local test fixtures — sample reports and handouts, not part of the product
.fixtures/
